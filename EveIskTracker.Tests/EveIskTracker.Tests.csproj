<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EveIskTracker.Desktop\EveIskTracker.Desktop.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net6.0-windows, weil das Hauptprojekt WinForms einbindet -->
