    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Muss zur App passen, sonst laufen Formatierungstests unter anderen Bedingungen -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
